# Configuración del Servidor
PORT=3000

# Clave Secreta para Encriptación AES-256-CBC (Debe ser única y guardada bajo confidencialidad)
# Genera una clave segura aleatoria de 32 caracteres para producción
ENCRYPTION_KEY=tu_clave_secreta_aqui

# Hash SHA-256 de la contraseña del Administrador
# Para "CLAVE_ADMIN_PLACEHOLDER" el hash es: HASH_ROTADO_POR_SEGURIDAD
# Genera el hash de tu contraseña deseada usando SHA-256
ADMIN_PASSKEY_HASH=tu_hash_de_contrasena_aqui
